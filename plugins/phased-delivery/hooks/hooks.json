{
  "description": "Remind the agent to use plan-in-phases and implement-in-phases, and list unfinished phased plans in the repository",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
