{
  "type": "object", "additionalProperties": false,
  "required": ["before", "after", "assumptions", "test_budget", "stages", "notes"],
  "properties": {
    "before": {"type": "string"}, "after": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["status", "text", "evidence"],
      "properties": {"status": {"enum": ["verified", "open"]}, "text": {"type": "string"}, "evidence": {"type": "string"}}}},
    "test_budget": {"type": "string"},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "goal", "context", "contracts", "files", "behaviour", "external_inputs", "tests",
                   "done_when", "out_of_scope", "model_basis"],
      "properties": {
        "id": {"type": "string", "pattern": "^\\d\\d\\.\\d+$"},
        "goal": {"type": "string"},
        "context": {"type": "object", "additionalProperties": false, "required": ["builds_on", "code_read", "design"],
          "properties": {
            "builds_on": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["source", "what"], "properties": {"source": {"type": "string"}, "what": {"type": "string"}}}},
            "code_read": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["where", "shows", "fact"], "properties": {"where": {"type": "string"},
                "shows": {"type": "string"}, "fact": {"type": "string"}}}},
            "design": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["doc", "section", "quote"], "properties": {"doc": {"enum": ["spec", "design"]},
                "section": {"type": "string"}, "quote": {"type": "string"}}}}}},
        "contracts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["kind", "name", "shape", "direction", "counterparts"],
          "properties": {
            "kind": {"enum": ["function", "class", "route", "format", "config", "error", "event", "cli", "test-helper", "other"]},
            "name": {"type": "string"}, "shape": {"type": "string"},
            "direction": {"enum": ["provides", "uses"]},
            "counterparts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "other_reason": {"type": "string"}}}},
        "files": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["path", "action", "role"],
          "properties": {"path": {"type": "string"}, "action": {"enum": ["create", "edit", "delete"]}, "role": {"type": "string"}}}},
        "behaviour": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["given", "when", "then"],
          "properties": {"given": {"type": "string"}, "when": {"type": "string"}, "then": {"type": "string"}}}},
        "external_inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["source", "check", "on_failure"],
          "properties": {"source": {"type": "string"}, "check": {"type": "string"}, "on_failure": {"type": "string"}}}},
        "tests": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["test", "kind", "action", "proves"],
          "properties": {"test": {"type": "string"}, "kind": {"enum": ["outcome", "integration", "unit"]},
            "action": {"enum": ["writes", "turns on", "keeps passing", "deletes"]},
            "proves": {"type": "string"}, "why_unit": {"type": "string"}}}},
        "done_when": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "model_basis": {"type": "object", "additionalProperties": false,
          "required": ["J", "F", "R", "C", "K", "P", "V", "S"],
          "properties": {"J": {"type": "integer", "minimum": 0, "maximum": 2}, "F": {"type": "integer", "minimum": 0, "maximum": 2},
            "R": {"type": "integer", "minimum": 0, "maximum": 2}, "C": {"type": "integer", "minimum": 0, "maximum": 2},
            "K": {"type": "integer", "minimum": 0, "maximum": 2}, "P": {"type": "integer", "minimum": 0, "maximum": 2},
            "V": {"type": "integer", "minimum": 0, "maximum": 2}, "S": {"type": "integer", "minimum": 0, "maximum": 2}}}}}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
