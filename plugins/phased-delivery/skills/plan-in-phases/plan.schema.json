{
  "type": "object", "additionalProperties": false,
  "required": ["size", "outcomes", "decisions", "contracts", "outcome_tests", "phases"],
  "definitions": {
    "source": {"type": "object", "additionalProperties": false, "required": ["doc", "section", "quote"],
      "properties": {"doc": {"enum": ["spec", "design"]}, "section": {"type": "string"},
        "quote": {"type": "string"}}}
  },
  "properties": {
    "size": {"type": "object", "additionalProperties": false, "required": ["verdict", "evidence"],
      "properties": {"verdict": {"enum": ["full", "small"]}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "title", "observable", "how_to_check", "sources"],
      "properties": {"id": {"type": "string", "pattern": "^O\\d+$"}, "title": {"type": "string"},
        "observable": {"type": "string"}, "how_to_check": {"type": "string"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/source"}}}}},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "text", "reason", "phases"],
      "properties": {"id": {"type": "string", "pattern": "^D\\d+$"}, "text": {"type": "string"},
        "reason": {"type": "string"},
        "phases": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(\\d\\d|all)$"}},
        "user_answer": {"enum": ["given", "assumed"]},
        "departs_from": {"$ref": "#/definitions/source"}}}},
    "contracts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "shape", "provided_by", "used_by"],
      "properties": {"id": {"type": "string", "pattern": "^C\\d+$"},
        "kind": {"enum": ["function", "class", "route", "format", "config", "error", "event", "cli", "test-helper", "other"]},
        "name": {"type": "string"}, "shape": {"type": "string"},
        "provided_by": {"type": "string"},
        "used_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "other_reason": {"type": "string"}}}},
    "outcome_tests": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["outcome", "test", "written_in", "passes_from"],
      "properties": {"outcome": {"type": "string", "pattern": "^O\\d+$"}, "test": {"type": "string"},
        "written_in": {"type": "string"}, "passes_from": {"type": "string"}}}},
    "phases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["phase", "file", "name", "kind", "stages"],
      "properties": {"phase": {"type": "string", "pattern": "^\\d\\d$"},
        "file": {"type": "string", "pattern": "^\\d\\d-[a-z0-9-]+\\.md$"},
        "name": {"type": "string"},
        "kind": {"enum": ["skeleton", "interfaces", "internals", "integration", "behaviour"]},
        "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "title", "files", "provides", "uses", "order"],
          "properties": {"id": {"type": "string", "pattern": "^\\d\\d\\.\\d+$"}, "title": {"type": "string"},
            "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
              "required": ["path", "action"],
              "properties": {"path": {"type": "string"}, "action": {"enum": ["create", "edit", "delete"]}}}},
            "provides": {"type": "array", "items": {"type": "string", "pattern": "^C\\d+$"}},
            "uses": {"type": "array", "items": {"type": "string", "pattern": "^C\\d+$"}},
            "order": {"type": "string", "pattern": "^(first|after \\d\\d\\.\\d+|parallel with \\d\\d\\.\\d+)$"}}}}}}}
  }
}
