{
  "type": "object", "additionalProperties": false,
  "required": ["description", "goal", "why", "size", "outcomes", "decisions", "existing", "phases"],
  "definitions": {
    "source": {"type": "object", "additionalProperties": false, "required": ["doc", "section", "quote"],
      "properties": {"doc": {"enum": ["spec", "design"]}, "section": {"type": "string"},
        "quote": {"type": "string"}}}
  },
  "properties": {
    "description": {"type": "string"}, "goal": {"type": "string"}, "why": {"type": "string"},
    "size": {"type": "object", "additionalProperties": false, "required": ["verdict", "evidence"],
      "properties": {"verdict": {"enum": ["full", "quick"]}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "title", "observable", "how_to_check", "sources"],
      "properties": {"id": {"type": "string", "pattern": "^O\\d+$"}, "title": {"type": "string"},
        "observable": {"type": "string"}, "how_to_check": {"type": "string"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/source"}}}}},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "text", "reason", "phases"],
      "properties": {"id": {"type": "string", "pattern": "^D\\d+$"}, "text": {"type": "string"},
        "reason": {"type": "string"},
        "phases": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(\\d\\d|all)$"}},
        "user_answer": {"enum": ["given", "assumed"]},
        "departs_from": {"$ref": "#/definitions/source"}}}},
    "existing": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["kind", "name", "shape", "path"],
      "properties": {
        "kind": {"enum": ["function", "class", "route", "format", "config", "error", "event", "cli", "test-helper", "other"]},
        "name": {"type": "string"}, "shape": {"type": "string"}, "path": {"type": "string"}}}},
    "docs": {"type": "object", "additionalProperties": false,
      "properties": {"spec": {"type": "string"}, "design": {"type": "string"}}},
    "phases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["phase", "dir", "name", "kind"],
      "properties": {"phase": {"type": "string", "pattern": "^\\d\\d$"},
        "dir": {"type": "string", "pattern": "^\\d\\d-[a-z0-9-]+$"},
        "name": {"type": "string"},
        "kind": {"enum": ["skeleton", "interfaces", "internals", "integration", "behaviour"]}}}}
  }
}
