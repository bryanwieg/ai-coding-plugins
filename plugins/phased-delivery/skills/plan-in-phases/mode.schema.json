{
  "definitions": {
    "terms": {"type": "object", "additionalProperties": false, "required": ["request", "terms"],
      "properties": {
        "request": {"type": "string"},
        "terms": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "form": {"type": "object", "additionalProperties": false,
      "required": ["request", "opened", "parts", "unresolved", "open_questions"],
      "properties": {
        "request": {"type": "string"},
        "opened": {"type": "array", "items": {"type": "string"}},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/part"}},
        "unresolved": {"type": "array", "items": {"type": "string"}},
        "open_questions": {"type": "array", "items": {"type": "string"}}}},
    "part": {"type": "object", "additionalProperties": false,
      "required": ["title", "kind", "files", "lines", "changes"],
      "properties": {
        "title": {"type": "string"},
        "kind": {"enum": ["new", "internal", "interface", "architecture", "data"]},
        "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["path", "action"],
          "properties": {"path": {"type": "string"}, "action": {"enum": ["create", "edit", "delete"]}}}},
        "lines": {"enum": ["under 30", "30-150", "over 150"]},
        "changes": {"type": "array", "items": {"type": "string"}},
        "existing_data": {"type": "boolean"}}}
  }
}
